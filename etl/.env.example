MB_CONTACT=you@example.com

# Target Medusa instance. Point this at a deployed backend to reseed after
# Phase 5 without changing the script.
MEDUSA_BASE_URL=http://localhost:9000

# A Medusa secret API key, minted once per environment after the admin user
# and Phase 1 bootstrap (region/sales channel/stock location/shipping
# profile) already exist. Mint one via:
#
#   TOKEN=$(curl -s -X POST $MEDUSA_BASE_URL/auth/user/emailpass \
#     -H 'Content-Type: application/json' \
#     -d '{"email":"<admin-email>","password":"<admin-password>"}' | jq -r .token)
#
#   curl -s -X POST $MEDUSA_BASE_URL/admin/api-keys \
#     -H "Authorization: Bearer $TOKEN" -H 'Content-Type: application/json' \
#     -d '{"title":"Catalog ETL","type":"secret"}' | jq -r .api_key.token
MEDUSA_ADMIN_API_KEY=sk_...

# migrate_images_to_s3.py only: substring identifying the new file host,
# used to detect products that are already migrated. For local Supabase
# Storage this is the API_URL from `supabase status` (host:port only).
NEW_FILE_HOST=localhost:54321
