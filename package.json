{
  "name": "vinyl-cut",
  "private": true,
  "packageManager": "pnpm@11.13.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm -r --filter=@dtc/storefront dev",
    "env:up": "supabase start && docker compose up -d",
    "env:down": "docker compose down && supabase stop",
    "env:status": "supabase status && docker compose ps",
    "env:restart": "pnpm env:down && pnpm env:up",
    "backend:logs": "docker compose logs -f medusa",
    "dev:full": "pnpm env:up && pnpm storefront:dev"
  },
  "devDependencies": {
    "@medusajs/eslint-plugin": "2.16.0",
    "eslint": "^9.39.4",
    "jiti": "^2.7.0",
    "prettier": "^3.2.5",
    "turbo": "^2.0.14"
  }
}
