{
  "name": "@vc/storefront",
  "version": "0.1.0",
  "description": "The Vinyl-Cut Storefront.",
  "author": "Narciso Lobo <narciso@narcisolobo.com>",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "next dev -p ${PORT:-8000}",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "analyze": "ANALYZE=true next build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "revalidate": "curl -sf -X POST \"http://localhost:${PORT:-8000}/api/revalidate?tag=products\""
  },
  "dependencies": {
    "@medusajs/js-sdk": "^2.18.0",
    "@medusajs/types": "2.18.0",
    "@phosphor-icons/react": "^2.1.10",
    "@sentry/nextjs": "^10.70.0",
    "@stripe/react-stripe-js": "^6.8.1",
    "@stripe/stripe-js": "^9.13.0",
    "clsx": "^2.1.1",
    "next": "16.2.11",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "slugify": "^1.6.9",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "19.0.5",
    "@types/react-dom": "19.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "babel-plugin-react-compiler": "1.0.0",
    "daisyui": "^5.7.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^7.3.6",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10"
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-tailwindcss"
    ]
  },
  "packageManager": "pnpm@11.17.0"
}
